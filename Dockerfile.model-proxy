# Holds the model credentials so the reviewers do not have to.
#
# Long-lived and tiny: no docker socket, no gh, no git — it forwards HTTP and
# puts one header on the way past. Everything it can reach is one of two
# upstreams, which is the point of it being its own image.
FROM python:3.12-slim-bookworm

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir ".[proxy]"

ENV PYTHONUNBUFFERED=1
EXPOSE 8080
ENTRYPOINT ["python", "-m", "robbie_proxy.main"]
