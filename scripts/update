#!/usr/bin/env bash
# Pull the repo and restart on the new code.
#
#   scripts/update
#
# Builds both images every time, on purpose: the reviewer image carries
# reviewer/entrypoint.sh, and a change there is invisible until something
# rebuilds it.
#
# Draining before building, not after, is what keeps the reviewers in flight
# alive: they hold an ANTHROPIC_BASE_URL pointing at model-proxy and they were
# spawned from an image the orchestrator that owns them agrees with. So an update
# can take as long as the longest running review, and the stack is briefly down
# for the build rather than briefly inconsistent underneath it.
set -euo pipefail

cd "$(dirname "$0")/.."

if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
  echo "the working tree has changes; commit or stash them first:" >&2
  git status --short --untracked-files=no >&2
  exit 1
fi

before="$(git rev-parse --short HEAD)"
if git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
  echo "pulling…"
  git pull --ff-only
else
  echo "no upstream for $(git rev-parse --abbrev-ref HEAD); rebuilding what is here"
fi
after="$(git rev-parse --short HEAD)"

if [[ "$before" == "$after" ]]; then
  echo "already at $after — rebuilding anyway in case the images are older"
else
  echo "$before → $after"
  git --no-pager log --oneline "$before..$after"
  # a new key in the shipped example is a key your config does not have yet
  if ! git diff --quiet "$before..$after" -- config/robbie.yaml.example .env.example; then
    echo
    echo "! robbie.yaml.example or .env.example changed — diff them against yours:"
    echo "    git diff $before..$after -- config/robbie.yaml.example .env.example"
  fi
fi

# A service behind a profile is invisible to a plain `compose up -d`, so it would
# keep running the old image without a word. Whichever are up now stay up.
profiles=()
running="$(docker compose ps --services 2>/dev/null)"
for pair in dashboard:dashboard model-proxy:proxy mcp-sentry:sentry; do
  grep -qx "${pair%%:*}" <<<"$running" && profiles+=(--profile "${pair##*:}")
done
[[ ${#profiles[@]} -gt 0 ]] && echo "profiles up:${profiles[*]//--profile/}"

echo
echo "draining robbie (SIGTERM; it finishes the tick, so this can take a while)…"
docker compose stop robbie
echo "building…"
docker compose "${profiles[@]}" build
echo "restarting…"
docker compose "${profiles[@]}" up -d

echo
docker compose "${profiles[@]}" ps
echo
echo "  docker compose logs -f robbie"
