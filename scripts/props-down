#!/usr/bin/env bash
# Stop the PR Ops reviewer stack. In-flight reviewer containers get a grace
# stop; state and images stay, so tomorrow's props-up is instant.
set -euo pipefail
cd "$(dirname "$0")/.."
docker ps --format '{{.Names}}' | grep '^robbie-' | xargs -r docker stop -t 10 || true
docker compose down
echo "PR Ops reviewer: down"
