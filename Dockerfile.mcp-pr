# The fixer's one write tool, as an MCP sidecar.
#
# Long-lived and tiny: it exists so the ONLY token that can write to the
# repository lives here instead of in a container running a model with
# bypassPermissions against a bug report anybody can file.
FROM python:3.12-slim-bookworm

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src/robbie_mcp ./src/robbie_mcp
# the versions come from the [mcp] extra, so they cannot drift from pyproject
RUN pip install --no-cache-dir ".[mcp]"

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    MCP_HOST=0.0.0.0 \
    MCP_PORT=8080

# git is the whole of the write path: clone the mirror, apply, push
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home mcp
USER mcp
EXPOSE 8080

ENTRYPOINT ["python", "-m", "robbie_mcp.pr"]
