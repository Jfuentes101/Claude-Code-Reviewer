# robbie config. Everything non-secret lives here; secrets come from the env.
# Copy to config/robbie.yaml. Unknown keys are a startup error, not a warning.

backend: api            # api = ANTHROPIC_API_KEY | oauth = CLAUDE_CREDENTIALS
poll_interval_s: 600
max_concurrent_reviews: 3
state_dir: /var/lib/robbie
# The interactive default is richer than a review loop needs. Account arms only:
# the CLI sends this as `output_config.effort`, which ollama's /v1/messages drops
# (its own reasoning_effort works on the OpenAI path the CLI does not speak), so a
# `via: endpoint` arm reasons at whatever depth the model defaults to.
review_effort: high
stale_review_days: 7    # `robbie digest` threshold

# HOST path to robbie's cross-repo review standards. Mounted read-only into every
# reviewer and copied to its user scope, where the CLI loads it unprompted — so
# it costs no prompt tokens and the model cannot skip it. A PR cannot touch it.
# Edit the files and the next review uses them; no rebuild, no restart.
policy_dir: /opt/robbie/policy

# Read-only context the REVIEW MODEL may pull while judging. Empty = none.
# `stdio` runs inside the reviewer image; `http` reaches a compose sidecar, which
# is how a token stays out of a container running bypassPermissions.
# Not for robbie's own notifications — those are plain HTTP from the orchestrator.
#
# Naming a sidecar here is half of turning it on: it also needs `sentry` in
# COMPOSE_PROFILES (.env) and a SENTRY_TOKEN. Without both, the sidecar never
# starts and every review fails its MCP connection to a name that does not
# resolve — so this ships empty and the line below is what you uncomment.
review_mcp: ''
# review_mcp: '{"mcpServers":{"sentry":{"type":"http","url":"http://mcp-sentry:8080/mcp"}}}'

# Where the model-credential proxy listens. Empty (the default) hands every
# reviewer the real key, or on backend=oauth mounts the account's whole session
# file — into a container running a PR's own code with bypassPermissions. Set it
# and the container gets MODEL_PROXY_TOKEN instead, which buys nothing off this
# network. Keep `proxy` in COMPOSE_PROFILES (.env) or the sidecar never comes up
# and robbie refuses to boot: this is a startup check, not a runtime one.
model_proxy: http://model-proxy:8080

docker:
  cpus: "2"
  memory: 4g
  pids_limit: 512
  timeout_s: 1800       # per-review cap
  # must match the network name in docker-compose.yml, or a spawned reviewer
  # cannot resolve the sidecars. null keeps them off the compose network.
  network: robbie

# Comparing models on one unchanged harness. Empty (the default) runs every review
# on the account's own model. Listing arms splits reviews between them by weight —
# below is two reviews on the third-party endpoint for every one on the account.
#
# `via: endpoint` sends the run to REVIEW_BASE_URL with REVIEW_API_TOKEN, and that
# is also what picks the meter the spend gate reads: a run billed by a third party
# must not be held against the account's window, and vice versa. A model listed
# here is also the only kind `robbie once --model <tag>` will route off-account.
# review_models:
#   - {model: glm-5.2:cloud, via: endpoint, weight: 2}
#   - {model: sonnet, weight: 1}

budget:
  daily_usd: 20.0       # backend=api: measured from each run's reported cost
  stop_pct: 70          # backend=oauth: pause at this % of the 5h window
  # the endpoint's own session/weekly allowance, as a percentage of it. Its cost
  # cannot be gated in dollars: the CLI reports a price from its own table for a
  # model it does not price, and that number is not the third party's bill.
  endpoint_stop_pct: 80
  endpoint_reserve_pct: 5.0
  # Held back for each review in flight and for the one asking, because both
  # numbers above measure what has been SPENT and a running container has not
  # finished spending. Without it a free slot starts on a stale reading.
  reserve_pct: 8.0      # backend=oauth
  reserve_usd: 5.0      # backend=api

slack:
  owner_id: U01234567           # gets holds, failures and operator warnings
  users_file: /etc/robbie/slack-users.tsv
  # An `ok` is the only verdict that leaves nothing on the PR, so it is the only
  # one that DMs. Everyone who shares the review queue wants that line; leave it
  # out and only owner_id gets it.
  approved_ids: [U01234567, U07654321]

repos:
  - slug: acme/webapp
    reviewer_login: robbie-bot    # whose pending review request defines the queue
    # HOST path — the orchestrator hands this to the host docker daemon
    bare: /srv/robbie/repos/webapp.git
    label: "Code Review"
    needs_work_label: "❌ NEEDS WORK! ❌"
    # waiting on something that is not the author — a dependency PR, usually. No
    # review while it is on, and it comes back by itself when it comes off.
    hold_labels: ["Blocked"]
    # a human already reviewed and approved it. Excluding: a PR carrying one of
    # these AND `label` is not reviewed, and it leaves the dashboard too.
    done_labels: ["Ready for Prod", "Ready to Merge"]
    review_command: .claude/commands/code-review.md
    # which ref `review_command` is read from. NOT the PR's base branch: the PR
    # picks that, so a branch carrying poisoned criteria could be targeted as the
    # base and become the rules. Set it to this repo's trunk.
    criteria_ref: main
    slack_channel: C01234567
    image: robbie-reviewer:latest
    ignore_checks: ["CodeRabbit"]
    # posted as the whole comment body on an `ok`, to start a build that no
    # longer runs on push. Whatever listens for it may match the entire comment.
    ci_phrase: run-ci
