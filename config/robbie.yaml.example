# robbie config. Everything non-secret lives here; secrets come from the env.
# Copy to config/robbie.yaml. Unknown keys are a startup error, not a warning.

backend: api            # api = ANTHROPIC_API_KEY | oauth = CLAUDE_CREDENTIALS
poll_interval_s: 600
max_concurrent_reviews: 3
state_dir: /var/lib/robbie
review_effort: high     # the interactive default is richer than a review loop needs
stale_review_days: 7    # `robbie digest` threshold

# HOST path to robbie's cross-repo review standards. Mounted read-only into every
# reviewer and copied to its user scope, where the CLI loads it unprompted — so
# it costs no prompt tokens and the model cannot skip it. A PR cannot touch it.
# Edit the files and the next review uses them; no rebuild, no restart.
policy_dir: /opt/robbie/policy

# Read-only context the REVIEW MODEL may pull while judging. Empty = none.
# `stdio` runs inside the reviewer image; `http` reaches a compose sidecar, which
# is how a token stays out of a container running bypassPermissions.
# Not for robbie's own notifications — those are plain HTTP from the orchestrator.
review_mcp: '{"mcpServers":{"sentry":{"type":"http","url":"http://mcp-sentry:8080/mcp"}}}'

docker:
  cpus: "2"
  memory: 4g
  pids_limit: 512
  timeout_s: 1800       # per-review cap
  # must match the network name in docker-compose.yml, or a spawned reviewer
  # cannot resolve the sidecars. null keeps them off the compose network.
  network: robbie

budget:
  daily_usd: 20.0       # backend=api: measured from each run's reported cost
  stop_pct: 70          # backend=oauth: pause at this % of the 5h window
  # Held back for each review in flight and for the one asking, because both
  # numbers above measure what has been SPENT and a running container has not
  # finished spending. Without it a free slot starts on a stale reading.
  reserve_pct: 8.0      # backend=oauth
  reserve_usd: 5.0      # backend=api

slack:
  owner_id: U01234567           # gets holds, failures and operator warnings
  users_file: /etc/robbie/slack-users.tsv
  # An `ok` is the only verdict that leaves nothing on the PR, so it is the only
  # one that DMs. Everyone who shares the review queue wants that line; leave it
  # out and only owner_id gets it.
  approved_ids: [U01234567, U07654321]

repos:
  - slug: acme/webapp
    reviewer_login: robbie-bot    # whose pending review request defines the queue
    # HOST path — the orchestrator hands this to the host docker daemon
    bare: /srv/robbie/repos/webapp.git
    label: "Code Review"
    needs_work_label: "❌ NEEDS WORK! ❌"
    review_command: .claude/commands/code-review.md
    slack_channel: C01234567
    image: robbie-reviewer:latest
    ignore_checks: ["CodeRabbit"]
    # posted as the whole comment body on an `ok`, to start a build that no
    # longer runs on push. Whatever listens for it may match the entire comment.
    ci_phrase: run-ci
