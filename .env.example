# Copy to .env, chmod 600. Secrets never go in robbie.yaml.

# Which optional services come up. Every sidecar sits behind a compose profile,
# so WITHOUT this a plain `docker compose up -d` starts the orchestrator alone —
# and `model_proxy` in robbie.yaml is a BOOT check, not a runtime one: robbie
# exits rather than review without it. Compose reads this file on its own, so
# setting it here is what makes `up -d`, scripts/setup and scripts/update all
# bring up the same stack.
#   proxy      keeps the model credentials out of the reviewers (model_proxy)
#   dashboard  the read-only panel on 127.0.0.1:4020
#   sentry     the mcp-sentry sidecar; needs SENTRY_TOKEN or it restart-loops
COMPOSE_PROFILES=proxy

# Both tokens: which permissions to tick, and the three ways generating them goes
# wrong, are in README.md -> "The two GitHub tokens". Fine-grained, one repo each.
#
# Publishes reviews, so it must belong to repos[].reviewer_login and needs
# Pull requests + Issues at READ AND WRITE, Contents + Commit statuses read.
GH_TOKEN=github_pat_...

# Handed to the reviewer containers instead of GH_TOKEN when set. Put a
# READ-ONLY token here: the reviewer runs a model with bypassPermissions and
# publishing is not its job. Contents + Pull requests read is all it uses.
GH_TOKEN_REVIEWER=github_pat_...

SLACK_BOT_TOKEN=xoxb-...

# backend=api
ANTHROPIC_API_KEY=sk-ant-...

# backend=oauth instead: a copy of ~/.claude/.credentials.json from a machine
# where `claude login` has run. Same HOST-path rule as the mirrors — the
# orchestrator hands this path to the host daemon when it spawns a reviewer, so
# compose mounts it at the same path on both sides. Owned by ROBBIE_UID (mode 600).
# CLAUDE_CREDENTIALS=/srv/robbie/claude-credentials.json
#
# And the directory it sits in, which is what the long-lived services actually
# mount: the CLI renews the token by renaming a new file over the old one, so a
# container that bind-mounts the *file* keeps the inode it booted with and starts
# failing every review the first time the host refreshes. Give this file its own
# directory — everything in it is readable by those containers.
# CLAUDE_CREDENTIALS_DIR=/srv/robbie

# mcp-sentry sidecar. Read-only scopes: event:read, project:read. This token is
# never handed to a reviewer container — the sidecar holds it and exposes only
# read tools. Drop the service from docker-compose.yml if you don't want it.
SENTRY_TOKEN=sntrys_...
SENTRY_ORG_SLUG=acme
# Optional project filter, '["4501001","4501002"]' or '4501001,4501002'.
# Empty means every project the token can see.
SENTRY_PROJECTS=

# Reviewing with something other than the account's own model: any endpoint that
# speaks the Anthropic Messages API. Used by `robbie once --model <tag>` and by
# every `review_models` arm marked `via: endpoint`, which is how the daemon splits
# its reviews between providers. Spend on it is gated with the endpoint's own
# session/weekly meter, not in dollars — see budget.endpoint_stop_pct.
#
# ollama.com serves /v1/messages, so a token is all it needs — no local ollama, no
# sidecar, no OAuth, and nothing mounted into the container. Key from
# ollama.com -> settings -> keys. A URL on the host's localhost will NOT work: the
# reviewer resolves it inside its own container.
REVIEW_BASE_URL=https://ollama.com
REVIEW_API_TOKEN=

# Shared secret between the orchestrator and the model-credential proxy. What a
# reviewer container holds INSTEAD of a real key: the proxy swaps in the account's
# OAuth session or the endpoint's key on the way past, so the container never sees
# either. Worth nothing off the compose network, which is the whole point.
#   openssl rand -hex 32
# Needed only when robbie.yaml sets `model_proxy`; robbie refuses to start without
# it in that case, and verifies it against the sidecar at boot.
MODEL_PROXY_TOKEN=

# Which upstream paths that proxy forwards at all, comma-separated. Leave it
# empty: the default is the model surface (v1/messages, v1/models) and nothing
# else, so the token above cannot spend the credential behind it on the account's
# usage, profile or organization endpoints. Widen it only if a CLI release starts
# calling somewhere new — a refused path says so in the run's transcript.
MODEL_PROXY_PATHS=

# Host path to the shipped policy/ directory (robbie's review standards). Must
# match policy_dir in robbie.yaml.
ROBBIE_POLICY=/opt/robbie/policy

# Host directory holding the bare mirrors. Mounted at the same path inside the
# orchestrator so config paths mean the same thing on both sides.
# Create the mirror yourself before `compose up` — it is mounted read-only, so
# nothing in compose can: ./scripts/mirror-sync owner/repo
ROBBIE_MIRRORS=/srv/robbie/repos

# Where the database and transcripts live. A named docker volume by default, at
# /var/lib/robbie inside — which is what state_dir says. Set a HOST path instead
# to keep them reachable from the host (scripts/model-compare, a venv dashboard):
# it is mounted at that same path, so state_dir becomes that path too.
# ROBBIE_STATE=/srv/robbie/state

# The reviewer image builds its user with these. On backend=oauth they must be
# the owner of CLAUDE_CREDENTIALS — it is mounted mode 600. `id -u` / `id -g`.
ROBBIE_UID=1000
ROBBIE_GID=1000

# ROBBIE_LOG_LEVEL=INFO
# ROBBIE_LOG_FORMAT=json
