# Copy to .env, chmod 600. Secrets never go in robbie.yaml.

# Publishes reviews, so it needs write access to the repo.
GH_TOKEN=ghp_...

# Handed to the reviewer containers instead of GH_TOKEN when set. Put a
# READ-ONLY token here: the reviewer runs a model with bypassPermissions and
# publishing is not its job.
GH_TOKEN_REVIEWER=ghp_...

SLACK_BOT_TOKEN=xoxb-...

# backend=api
ANTHROPIC_API_KEY=sk-ant-...

# backend=oauth instead: a copy of ~/.claude/.credentials.json from a machine
# where `claude login` has run. Mounted read-write, because the CLI refreshes
# the token in place.
# CLAUDE_CREDENTIALS=/etc/robbie/claude-credentials.json

# Host directory holding the bare mirrors. Mounted at the same path inside the
# orchestrator so config paths mean the same thing on both sides.
ROBBIE_MIRRORS=/srv/robbie/repos

# ROBBIE_LOG_LEVEL=INFO
# ROBBIE_LOG_FORMAT=json
